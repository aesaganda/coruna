# Coruna Environment Configuration

# Web Server Settings (Exploit Delivery)
WEB_SERVER_IP=0.0.0.0
WEB_SERVER_PORT=80

# C2 Server Settings (TCP Listener)
C2_BIND=0.0.0.0
C2_PORT=8080

# Directory Paths (Relative to app root or absolute)
EXPLOIT_TEMPLATES_DIR=exploits/
STATIC_FILES_DIR=web_server/static/

# Headless mode: set to 1 for non-interactive daemon runs
CORUNA_HEADLESS=0
